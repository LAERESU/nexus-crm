# Salin menjadi .env lalu ganti nilainya. File .env tidak masuk Git.
# Hindari karakter khusus (" ' ; @ : /) pada password karena dipakai di connection string.
ORACLE_PASSWORD=ganti_password_sys
# Password untuk ketujuh user schema (AUTH_SCHEMA, USR_SCHEMA, dst.)
ORACLE_APP_PASSWORD=ganti_password_app
REDIS_PASSWORD=ganti_password_redis
RABBITMQ_USER=nexus
RABBITMQ_PASSWORD=ganti_password_rabbit
RUSTFS_ACCESS_KEY=nexus
RUSTFS_SECRET_KEY=ganti_password_rustfs
# Password user admin@demo.local untuk Auth Service di Development (kosongkan untuk tidak membuat seed)
SEED_ADMIN_PASSWORD=ganti_password_admin
