{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Auth": {
    "Jwt": {
      "JwksUrl": "http://localhost:5101/.well-known/jwks.json",
      "RequireHttpsMetadata": false
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5101"
          }
        }
      },
      "user": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5102"
          }
        }
      },
      "project": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5103"
          }
        }
      },
      "task": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5104"
          }
        }
      },
      "sop": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5105"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5106"
          }
        }
      },
      "notification-hub": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5106"
          }
        }
      }
    }
  }
}
