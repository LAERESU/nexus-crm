{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/v1/auth/{**rest}"
        },
        "AuthorizationPolicy": "anonymous"
      },
      "auth-health": {
        "ClusterId": "auth",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/auth/health",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ]
      },
      "users": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/v1/users/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "users-health": {
        "ClusterId": "user",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/users/health",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ]
      },
      "roles": {
        "ClusterId": "user",
        "Match": {
          "Path": "/api/v1/roles/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "roles-health": {
        "ClusterId": "user",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/roles/health",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ]
      },
      "projects": {
        "ClusterId": "project",
        "Match": {
          "Path": "/api/v1/projects/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "projects-health": {
        "ClusterId": "project",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/projects/health",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ]
      },
      "tasks": {
        "ClusterId": "task",
        "Match": {
          "Path": "/api/v1/tasks/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "tasks-health": {
        "ClusterId": "task",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/tasks/health",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ]
      },
      "sops": {
        "ClusterId": "sop",
        "Match": {
          "Path": "/api/v1/sops/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "sops-health": {
        "ClusterId": "sop",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/sops/health",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ]
      },
      "notifications": {
        "ClusterId": "notification",
        "Match": {
          "Path": "/api/v1/notifications/{**rest}"
        },
        "AuthorizationPolicy": "default"
      },
      "notifications-health": {
        "ClusterId": "notification",
        "Order": -1,
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/v1/notifications/health",
          "Methods": [
            "GET"
          ]
        },
        "Transforms": [
          {
            "PathSet": "/health/live"
          }
        ]
      },
      "notifications-hub": {
        "ClusterId": "notification-hub",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/hubs/notifications/{**rest}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": {
            "Address": "http://auth:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "user": {
        "Destinations": {
          "d1": {
            "Address": "http://user:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "project": {
        "Destinations": {
          "d1": {
            "Address": "http://project:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "task": {
        "Destinations": {
          "d1": {
            "Address": "http://task:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "sop": {
        "Destinations": {
          "d1": {
            "Address": "http://sop:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://notification:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        }
      },
      "notification-hub": {
        "Destinations": {
          "d1": {
            "Address": "http://notification:8080"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:02:00"
        }
      }
    }
  }
}
